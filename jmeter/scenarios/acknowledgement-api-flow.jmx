              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - Distribute Repos across Threads" enabled="false">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import java.util.Random;

// Get repo count and thread count
int repoCount = vars.get(&quot;repo_count&quot;) as Integer
int threadCount = ctx.getThreadGroup().getNumThreads()

log.info(&quot;Repo count: &quot; + repoCount)
log.info(&quot;Threads count: &quot; + threadCount)

if (repoCount &lt; threadCount) {
    // Assign first repo to all threads
    vars.put(&quot;assigned_repo&quot;, vars.get(&quot;repo_name_1&quot;))
    vars.put(&quot;assigned_registry&quot;, vars.get(&quot;registry_name_1&quot;))
    vars.put(&quot;assigned_repo_images_count&quot;, vars.get(&quot;number_of_images_per_repo_1&quot;))
} else {
    // Generate a random repo index
    Random rand = new Random()
    int randomIndex = rand.nextInt(repoCount) + 1  // Random number between 1 and repoCount

    // Assign values from randomly selected repo
    vars.put(&quot;assigned_repo&quot;, vars.get(&quot;repo_name_&quot; + randomIndex))
    vars.put(&quot;assigned_registry&quot;, vars.get(&quot;registry_name_&quot; + randomIndex))
    vars.put(&quot;assigned_repo_images_count&quot;, vars.get(&quot;number_of_images_per_repo_&quot; + randomIndex))
}

// Log the assigned values
log.info(&quot;Assigned Repo: &quot; + vars.get(&quot;assigned_repo&quot;) + 
         &quot; Assigned Registry: &quot; + vars.get(&quot;assigned_registry&quot;) + 
         &quot; No of Images: &quot; + vars.get(&quot;assigned_repo_images_count&quot;))
</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - Distribute Repos across Threads" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import java.util.Random

// Get repo count and thread count
int repoCount = vars.get(&quot;repo_count&quot;)?.toInteger() ?: 0
int threadCount = ctx.getThreadGroup().getNumThreads()

log.info(&quot;Repo count: ${repoCount}&quot;)
log.info(&quot;Threads count: ${threadCount}&quot;)

if (repoCount &lt; 1) {
    log.error(&quot;Invalid repo count: ${repoCount}. Ensure repo_count is set correctly.&quot;)
    return
}

// Collect valid registry indexes (excluding &quot;Host Images&quot;)
List&lt;Integer&gt; validIndexes = []
for (int i = 1; i &lt;= repoCount; i++) {
    String registryName = vars.get(&quot;registry_name_${i}&quot;)
    if (registryName &amp;&amp; !registryName.equalsIgnoreCase(&quot;Host Images&quot;)) {
        validIndexes.add(i)
    }
}

// Check if we have valid repositories
if (validIndexes.isEmpty()) {
    log.error(&quot;No valid registries found. Only &apos;Host Images&apos; is present.&quot;)
    return
}

int selectedIndex
if (repoCount &lt; threadCount) {
    // Assign first valid repo to all threads
    selectedIndex = validIndexes.get(0)
} else {
    // Pick a random index from valid registries
    Random rand = new Random()
    selectedIndex = validIndexes.get(rand.nextInt(validIndexes.size()))
}

// Assign values from the randomly selected valid registry
vars.put(&quot;assigned_repo&quot;, vars.get(&quot;repo_name_${selectedIndex}&quot;))
vars.put(&quot;assigned_registry&quot;, vars.get(&quot;registry_name_${selectedIndex}&quot;))
vars.put(&quot;assigned_repo_images_count&quot;, vars.get(&quot;number_of_images_per_repo_${selectedIndex}&quot;))

// Log the assigned values
log.info(&quot;Assigned Repo: ${vars.get(&apos;assigned_repo&apos;)}, &quot; + 
         &quot;Assigned Registry: ${vars.get(&apos;assigned_registry&apos;)}, &quot; + 
         &quot;No of Images: ${vars.get(&apos;assigned_repo_images_count&apos;)}&quot;)
</stringProp>
              </JSR223PostProcessor>
