      <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">// Retrieve the &apos;be_type&apos; variable value
def be_type = vars.get(&quot;be_type&quot;)

// Determine the protocol based on the be_type value
def protocol = be_type == &quot;on-prem&quot; ? &quot;http&quot; : &quot;https&quot;

// Set the protocol variable for later use
vars.put(&quot;protocol&quot;, protocol)
</stringProp>
      </JSR223PreProcessor>
