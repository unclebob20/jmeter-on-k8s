                      <hashTree/>
                      <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - For Unack" enabled="true">
                        <stringProp name="scriptLanguage">groovy</stringProp>
                        <stringProp name="parameters"></stringProp>
                        <stringProp name="filename"></stringProp>
                        <stringProp name="cacheKey">true</stringProp>
                        <stringProp name="script">// Function to extract values with proper alignment and default handling
def getArray(variableName, defaultValue = &quot;&quot;) {
    def count = vars.get(variableName + &quot;_matchNr&quot;) as Integer ?: 0  // Get the match count
    def values = []
    
    for (int i = 0; i &lt; count; i++) {
        def value = vars.get(variableName + &quot;_&quot; + i)
        values.add(value != null ? value : defaultValue)  // Ensure null values are replaced
    }
    
    return values
}

// Fetch extracted arrays with correct alignment
def issueNames = getArray(&quot;ack_issue_name&quot;, &quot;unknown&quot;)
def issueTypes = getArray(&quot;ack_issue_type&quot;, &quot;vulnerability&quot;)
def resourceTypes = getArray(&quot;ack_resource_type&quot;, &quot;unknown&quot;)
def resourceCPEs = getArray(&quot;ack_resource_cpe&quot;, &quot;unknown&quot;)
def resourceNames = getArray(&quot;ack_resource_name&quot;, &quot;unknown&quot;)
def resourceVersions = getArray(&quot;ack_resource_version&quot;, &quot;unknown&quot;)
def resourcePaths = getArray(&quot;ack_resource_path&quot;, &quot;&quot;)  // Default to empty string
def images = getArray(&quot;ack_image&quot;, &quot;&quot;)
def registry = getArray(&quot;ack_registry&quot;)

//def registry = vars.get(&quot;assigned_registry&quot;) ?: &quot;default_registry&quot;

// Manually construct JSON
def ackjsonString = &apos;{ &quot;issues&quot;: [&apos;

boolean firstEntrySkipped = false  // Track whether to skip the first entry

for (int i = 0; i &lt; resourceNames.size(); i++) {
    // Skip first entry if it&apos;s completely empty
    if (!firstEntrySkipped &amp;&amp; resourceNames[i] == &quot;unknown&quot; &amp;&amp; issueNames[i] == &quot;unknown&quot;) {
        firstEntrySkipped = true
        continue  // Skip empty first entry
    }

    ackjsonString += &apos;&apos;&apos;
        {
            &quot;issue_type&quot;: &quot;&apos;&apos;&apos; + issueTypes[i] + &apos;&apos;&apos;&quot;,
            &quot;issue_name&quot;: &quot;&apos;&apos;&apos; + issueNames[i] + &apos;&apos;&apos;&quot;,
            &quot;resource_type&quot;: &quot;&apos;&apos;&apos; + resourceTypes[i] + &apos;&apos;&apos;&quot;,
            &quot;resource_cpe&quot;: &quot;&apos;&apos;&apos; + resourceCPEs[i] + &apos;&apos;&apos;&quot;,
            &quot;resource_name&quot;: &quot;&apos;&apos;&apos; + resourceNames[i] + &apos;&apos;&apos;&quot;,
            &quot;resource_version&quot;: &quot;&apos;&apos;&apos; + resourceVersions[i] + &apos;&apos;&apos;&quot;,
            &quot;resource_path&quot;: &quot;&apos;&apos;&apos; + (resourcePaths[i] ?: &quot;&quot;) + &apos;&apos;&apos;&quot;,
            &quot;registry_name&quot;: &quot;&apos;&apos;&apos; + registry[i] + &apos;&apos;&apos;&quot;,
            &quot;image_name&quot;: &quot;&apos;&apos;&apos; + images[i] + &apos;&apos;&apos;&quot;,
            &quot;has_custom_severity&quot;: false
        }&apos;&apos;&apos;
    if (i &lt; resourceNames.size() - 1) {
        ackjsonString += &quot;,&quot;
    }
}

ackjsonString += &apos;], &quot;comment&quot;: &quot;Unacknowledgement&quot; }&apos;

// Store the final JSON in a JMeter variable
vars.put(&quot;finalackJson&quot;, ackjsonString)

// Debugging
//log.info(&quot;Final JSON String: &quot; + ackjsonString)
</stringProp>
                      </JSR223PostProcessor>
