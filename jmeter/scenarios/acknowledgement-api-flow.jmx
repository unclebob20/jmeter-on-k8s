                    <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - For ACK">
                      <stringProp name="scriptLanguage">groovy</stringProp>
                      <stringProp name="parameters"></stringProp>
                      <stringProp name="filename"></stringProp>
                      <stringProp name="cacheKey">true</stringProp>
                      <stringProp name="script">def getArray(variableName) {
    def values = vars.get(variableName + &quot;_ALL&quot;)  // JMeter stores multiple matches with _ALL
    return values ? values.split(&apos;,&apos;) : []  // Convert to array if not null
}

// Fetch extracted arrays from JMeter variables
def issueNames = getArray(&quot;issue_name&quot;)
def resourceTypes = getArray(&quot;resource_type&quot;)
def resourceNames = getArray(&quot;resource_name&quot;)
def resourceVersions = getArray(&quot;resource_version&quot;)
def resourcePaths = vars.get(&quot;resource_path&quot;)
def resourceCPEs = vars.get(&quot;resource_cpe&quot;)
def image = vars.get(&quot;resource_image&quot;)
def registry = vars.get(&quot;resource_registry&quot;)


log.info(&quot;Issues: &quot; + issueNames)
log.info(&quot;cpe: &quot; + resourceCPEs)
log.info(&quot;Path: &quot; + resourcePaths)
log.info(&quot;Image: &quot; + image)

// Manually construct JSON string
def jsonString = &apos;{ &quot;issues&quot;: [&apos;

for (int i = 0; i &lt; issueNames.size(); i++) {  // ✅ Fix: Use .size() instead of .length
    jsonString += &apos;&apos;&apos;
        {
            &quot;issue_type&quot;: &quot;vulnerability&quot;,
            &quot;issue_name&quot;: &quot;&apos;&apos;&apos; + (i &lt; issueNames.size() ? issueNames[i] : &quot;unknown&quot;) + &apos;&apos;&apos;&quot;,
            &quot;resource_type&quot;: &quot;&apos;&apos;&apos; + (i &lt; resourceTypes.size() ? resourceTypes[i] : &quot;unknown&quot;) + &apos;&apos;&apos;&quot;,
            &quot;resource_cpe&quot;: &quot;&apos;&apos;&apos; + resourceCPEs + &apos;&apos;&apos;&quot;,
            &quot;resource_name&quot;: &quot;&apos;&apos;&apos; + (i &lt; resourceNames.size() ? resourceNames[i] : &quot;unknown&quot;) + &apos;&apos;&apos;&quot;,
            &quot;resource_version&quot;: &quot;&apos;&apos;&apos; + (i &lt; resourceVersions.size() ? resourceVersions[i] : &quot;unknown&quot;) + &apos;&apos;&apos;&quot;,
            &quot;resource_path&quot;: &quot;&apos;&apos;&apos; + resourcePaths + &apos;&apos;&apos;&quot;,
            &quot;docker_id&quot;: &quot;&quot;,
		  &quot;expiration_days&quot;: 1,
            &quot;registry_name&quot;: &quot;&apos;&apos;&apos; + registry + &apos;&apos;&apos;&quot;,
            &quot;image_name&quot;: &quot;&apos;&apos;&apos; + image + &apos;&apos;&apos;&quot;
        }&apos;&apos;&apos; 
    if (i &lt; issueNames.size() - 1) { // ✅ Fix: Use .size() instead of .length
        jsonString += &quot;,&quot;
    }
}

jsonString += &apos;], &quot;comment&quot;: &quot;&apos; + image + &apos;-check&quot; }&apos;

// Store the final JSON in a JMeter variable
vars.put(&quot;finalJson&quot;, jsonString)

log.info(&quot;Final JSON String: &quot; + jsonString)
</stringProp>
                    </JSR223PostProcessor>
