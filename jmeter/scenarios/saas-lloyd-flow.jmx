            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import org.apache.commons.codec.binary.Base64;

String token = vars.get(&quot;aqua_token_enfgroup&quot;);
String[] tokenParts = token.split(&quot;\\.&quot;);
String eseJsonStr = new String(Base64.decodeBase64(tokenParts[1]));

def eseJson = new groovy.json.JsonSlurper().parseText(eseJsonStr);
String eseUrl = eseJson.csp_metadata.urls.ese_url;
vars.put(&quot;ese_address&quot;, eseUrl);
</stringProp>
